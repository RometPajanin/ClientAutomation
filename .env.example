NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Matches the PostgreSQL service in docker-compose.yml.
DATABASE_URL=postgresql://client_automation:client_automation@localhost:5433/client_automation?schema=public

# Public demo account: admin / demo-admin-password. Only the scrypt password
# hash is configured on the server.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$16384$8$5$qXLKXP6hX9Jq4_Cir9K2-Q$M_BDYdYf7i3cKQmktvYPxh9Tce3RpnVOIgh8Xfh6uX8

# Use a new random 32+ character value outside local development. This signs
# session cookies and derives per-session CSRF tokens.
SESSION_SECRET=development-only-session-secret-change-me
SESSION_TTL_SECONDS=28800
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Exact comma-separated browser origins. Cookie-authenticated CORS never uses *.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Behind a production TLS proxy, set this to its exact IP/CIDR or trusted hop.
TRUST_PROXY=false
REQUIRE_HTTPS=false

# Optional for storage-only development; required to run inquiry AI analysis.
# Create this key in Google AI Studio and never expose it in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_RETRIES=2

# Public inquiry-ingestion controls.
INQUIRY_RATE_LIMIT_MAX=10
INQUIRY_RATE_LIMIT_WINDOW_MS=60000
DUPLICATE_WINDOW_HOURS=24
