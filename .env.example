NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Matches the PostgreSQL service in docker-compose.yml.
DATABASE_URL=postgresql://client_automation:client_automation@localhost:5433/client_automation?schema=public

# Required for every /api/v1/admin request. Use a random value of 16+ characters.
ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Optional for storage-only development; required to run inquiry AI analysis.
# Create this key in Google AI Studio and never expose it in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_RETRIES=2

# Public inquiry-ingestion controls.
INQUIRY_RATE_LIMIT_MAX=10
INQUIRY_RATE_LIMIT_WINDOW_MS=60000
DUPLICATE_WINDOW_HOURS=24
